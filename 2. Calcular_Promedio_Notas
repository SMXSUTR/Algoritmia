Algoritmo Calcular_Promedio_Notas
    Definir nota1, nota2, nota3, promedio Como Real;
    Escribir "cual es tu primer nota";
    Leer nota1;
    Escribir "cual es tu segunda nota";
    Leer nota2;
    Escribir "cual es tu tercera nota";
    Leer nota3;
    promedio <- (nota1 + nota2 + nota3) / 3;
    Escribir "tu promedio es ", promedio;
FinAlgoritmo