Algoritmo Calcular_Salario_Empleado
    DEFINIR salario_minimo, dias_del_mes, salario_por_dias, dias_trabajados, valor_dias Como Real;
    salario_minimo <- 2000000;
    Escribir "dame los dias entre semana de tu mes";
    Leer dias_del_mes;
    salario_por_dias <- salario_minimo / dias_del_mes;
    Escribir "dime cuantos dias trabajas al mes";
    Leer dias_trabajados;
    valor_dias <- salario_por_dias * dias_trabajados;
    Escribir "el salario bruto al recibir por el empleado ", valor_dias;
FinAlgoritmo