Proceso veinte_alum
	// Definir variables
	definir n1,n2, n3 como real;
	definir n Como Entero;
	// Inicializar variables
	n2<-0;
	n3<-10;
	escribir "dame las notas del 1 al 10";
	// Leer notas
	para n<-1 hasta 5 Hacer
		leer n1;
		// Buscar nota mayor
		si n1>n2 y n1<11 Entonces
			n2<-n1;
		sino 
			// Buscar nota menor
			si n1<n3 y n1>0 Entonces
				n3<-n1;
			SiNo
				escribir "error";
			FinSi
		FinSi
	FinPara
	// Mostrar resultados
	escribir "la nota mas baja es: ", n2,". la menor nota es: ", n3;
FinProceso