Proceso mult_veinte
	// Definir variables
	definir n,n2 como real;
	escribir "multiplicaremos los primeros 20 numeros naturales";
	// Inicializar variables
	n<-0;
	n2<-1;
	// Multiplicar números
	Repetir
		n<-n+1;
		n2<-n2*n;
		// Mostrar resultado 
		escribir n2;
	Hasta Que n==20
FinProceso