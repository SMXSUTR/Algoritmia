Algoritmo pos_neg_neu
	// Definir variables
	definir n, positivo, negativo, neutro Como real;
	definir i como entero;
	// Inicializar contadores
	positivo<-0;
	negativo<-0;
	neutro<-0;
	// Leer 20 números
	para i<-1 hasta 20 Hacer
		leer n;
		// Verificar si el número es positivo
		si n>0 Entonces
			positivo<-positivo+1;
		SiNo
			// Verificar si el número es negativo
			si n<0 Entonces
				negativo<-negativo+1;
			SiNo
				// Verificar si el número es neutro
				si n=0 Entonces
					neutro<-neutro+1;
				FinSi
			FinSi
		FinSi
	FinPara
	// Mostrar resultados
	escribir " tu numero de positivos es ", positivo," tu numero de negativos es ", negativo, " tu numero de neutros es ", neutro;
FinAlgoritmo