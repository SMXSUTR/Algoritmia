Proceso nega_a_pos
	// Definir variables
	definir nd, negativo, total, guardado Como Real;
	// Inicializar variables
	nd<-0;
	total<-0;
	guardado<-0;
	// Repetir hasta leer 10 números
	Repetir
		nd<-nd+1;
		leer negativo;
		// Verificar que el número sea negativo
		si negativo<0 entonces
			// Convertir el número a positivo
			total<-(negativo*(-2))/2;
			// Mostrar número convertido
			escribir "tu numero queda como ",total;
			// Acumular suma
			guardado<-guardado+total;
		SiNo
			escribir "error";
		FinSi
	Hasta Que nd==10
	// Mostrar suma total
	escribir "da ", guardado;
FinProceso
