Algoritmo Calcular_Total_Compra
    Definir cantidad, precio, total Como Entero;
    Definir articulo Como Caracter;
    Escribir "que articulo quieres llevar?";
    Leer articulo;
    Escribir "cuantos vas a llevar?";
    Leer cantidad;
    Escribir "el precio individual es";
    Leer precio;
    total <- cantidad * precio;
    Escribir "el valor total es ", total;
FinAlgoritmo