Proceso num_5
    Definir numeros, n Como Entero;
    Dimension numeros[5];
	escribir"PROPOSITO: escribir y mostrar 5 numeros";
    Para n <- 0 Hasta 4 Hacer
        Escribir "Digite un numero: ";
        Leer numeros[n];
    FinPara
    Escribir "Los numeros ingresados son:";
    Para n <- 0 Hasta 4 Hacer
        Escribir "Los numeros son: ", numeros[n];
    FinPara
FinProceso